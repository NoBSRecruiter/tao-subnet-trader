[importlinter:contract:chain-shell]
name = chain imports only inward (core, protocol) and the leaf ops modules; the live feed gets its store by injection
type = forbidden
source_modules =
    taotrader.chain
forbidden_modules =
    taotrader.data
    taotrader.venues
    taotrader.features
