# taotrader import contracts (WP0). DESIGN.md section 4.2 "Import contracts" and section 10.6.
# Run: .venv/Scripts/lint-imports   (tests/core/test_static_gates.py runs it as well)
#
# Pure packages may not import time/datetime/random/os/uuid/asyncio/httpx/websockets (section 4.2). The packages
# core, protocol, features, risk, portfolio and strategies are pure as a whole and are covered here; inside engine
# only engine.engine and engine.reducer are pure, which the AST lint in tests/core/test_static_gates.py checks
# (import-linter refuses source modules that do not exist yet).

[importlinter]
root_package = taotrader
include_external_packages = True

[importlinter:contract:core-stdlib-only]
name = core imports only the stdlib (and is pure)
type = forbidden
source_modules =
    taotrader.core
forbidden_modules =
    taotrader.protocol
    taotrader.chain
    taotrader.data
    taotrader.features
    taotrader.venues
    taotrader.engine
    taotrader.risk
    taotrader.portfolio
    taotrader.strategies
    taotrader.backtest
    taotrader.reports
    taotrader.live
    taotrader.ops
    taotrader.cli
    httpx
    websockets
    xxhash
    duckdb
    numpy
    zstandard
    keyring
    scalecodec
    bittensor
    time
    datetime
    random
    os
    uuid
    asyncio

[importlinter:contract:protocol-core-only]
name = protocol imports only core (and is pure)
type = forbidden
source_modules =
    taotrader.protocol
forbidden_modules =
    taotrader.chain
    taotrader.data
    taotrader.features
    taotrader.venues
    taotrader.engine
    taotrader.risk
    taotrader.portfolio
