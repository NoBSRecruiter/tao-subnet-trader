type = forbidden
source_modules =
    taotrader.backtest
    taotrader.reports
forbidden_modules =
    taotrader.live
    taotrader.cli

[importlinter:contract:ops-leaf]
name = ops.config_load and ops.secrets are leaf modules (core, stdlib, keyring only)
type = forbidden
source_modules =
    taotrader.ops.config_load
    taotrader.ops.secrets
forbidden_modules =
    taotrader.protocol
    taotrader.chain
    taotrader.data
    taotrader.features
    taotrader.venues
    taotrader.engine
    taotrader.risk
