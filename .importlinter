    taotrader.strategies
    taotrader.backtest
    taotrader.reports
    taotrader.ops
forbidden_modules =
    taotrader.live

[importlinter:contract:bittensor-only-in-live]
name = no package outside live imports bittensor
type = forbidden
source_modules =
    taotrader.core
    taotrader.protocol
    taotrader.chain
    taotrader.data
    taotrader.features
