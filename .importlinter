    taotrader.ops.lock
    httpx
    websockets
    xxhash
    duckdb
    numpy
    zstandard
    scalecodec
    bittensor

[importlinter:contract:ops-private]
name = ops.logging/alerts/health/lock are imported only by ops and cli
type = forbidden
source_modules =
    taotrader.core
    taotrader.protocol
    taotrader.chain
    taotrader.data
    taotrader.features
    taotrader.venues
    taotrader.engine
    taotrader.risk
    taotrader.portfolio
    taotrader.strategies
    taotrader.backtest
    taotrader.reports
    taotrader.live
forbidden_modules =
    taotrader.ops.logging
    taotrader.ops.alerts
    taotrader.ops.health
    taotrader.ops.lock

[importlinter:contract:live-only-from-cli]
name = live is imported only by cli (behind the gate)
type = forbidden
source_modules =
    taotrader.core
    taotrader.protocol
    taotrader.chain
    taotrader.data
    taotrader.features
    taotrader.venues
    taotrader.engine
